# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'introToDesignSystem' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # openrsync treats a colon in --files-from as a remote path. This project
    # lives under SE104-UI:UX, so keep the CocoaPods file list outside that path.
    resources_script = File.join(
      __dir__,
      'Pods/Target Support Files/Pods-introToDesignSystem/Pods-introToDesignSystem-resources.sh'
    )
    if File.exist?(resources_script)
      contents = File.read(resources_script)
      patched = contents.gsub(
        'RESOURCES_TO_COPY=${PODS_ROOT}/resources-to-copy-${TARGETNAME}.txt',
        'RESOURCES_TO_COPY="/tmp/resources-to-copy-${TARGETNAME}.txt"'
      )
      File.write(resources_script, patched) if patched != contents
    end
  end
end
